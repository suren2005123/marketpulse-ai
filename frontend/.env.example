# MarketPulse AI Frontend Environment Configuration Template
# For standalone Vercel frontend deployment without backend:
# Leave VITE_API_BASE_URL empty or unset. The frontend runs in Standalone Presentation Mode with full simulated UI.

# Backend API Base URL (e.g. https://api.yourdomain.com or https://marketpulse-backend.onrender.com)
# When left empty, frontend requests relative paths (/api/...)
VITE_API_BASE_URL=

# Real-Time WebSocket URL (e.g. wss://api.yourdomain.com or https://marketpulse-backend.onrender.com)
# When left empty, falls back to VITE_API_BASE_URL or browser origin
VITE_WS_URL=
