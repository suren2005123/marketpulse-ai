# MarketPulse AI v2 — Environment Variables Configuration Template
# Copy this file to .env before starting services

# Application & Environment Mode
# Options: SIMULATED (default, no external credentials needed), HISTORICAL_REPLAY, LIVE, END_OF_DAY
APP_MODE=SIMULATED
NODE_ENV=development
PORT=5000
FRONTEND_PORT=5173
ML_SERVICE_PORT=8000

# Client URLs (for CORS and Socket.IO origin authorization)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
ML_SERVICE_URL=http://localhost:8000

# Authentication & Security
# Generate secure random strings for production (e.g., openssl rand -base64 32)
JWT_ACCESS_SECRET=marketpulse_jwt_access_super_secret_key_2026_dev_env
JWT_REFRESH_SECRET=marketpulse_jwt_refresh_super_secret_key_2026_dev_env
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECURE=false

# Rate Limiting & Lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Database Configuration (PostgreSQL 18 / SQLite fallback)
# To connect to your local PostgreSQL 18 database in pgAdmin:
# Option A: Connection string (recommended)
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/marketpulse
# Option B: Discrete credentials (takes precedence if provided)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=marketpulse
# DB_USER=postgres
# DB_PASSWORD=YOUR_POSTGRES_PASSWORD
# For standalone local zero-dependency development, set to 'sqlite:./marketpulse.sqlite' or leave blank for automatic fallback
DB_SSL=false

# Redis Configuration (Pub/Sub fan-out and rate-limiting)
# Production Redis URI: redis://localhost:6379
# Leave blank or set to 'mock' to use high-performance in-memory pub/sub adapter
REDIS_URL=redis://localhost:6379

# Authorized Market Data Providers
# Options for MARKET_DATA_PROVIDER: tejhq (Free EOD NSE/BSE Bhavcopy), upstox (Live WebSocket OAuth)
MARKET_DATA_PROVIDER=tejhq
TEJHQ_BASE_URL=https://api.tejhq.dev

# Upstox V3 configuration (Required only when MARKET_DATA_PROVIDER=upstox and APP_MODE=LIVE)
UPSTOX_API_VERSION=v3
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:5000/api/provider/upstox/callback
UPSTOX_ACCESS_TOKEN=

# Latency Budget & SLA Monitoring (Milliseconds)
REALTIME_LATENCY_BUDGET_MS=2000
HISTORICAL_REPLAY_SPEED=5x
